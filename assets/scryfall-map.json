  "structural_type_override_mapping": {
    "source_field": "type_line",
    "rules": [
      {
        "match": "Planeswalker",
        "taxonomy_value": "planeswalker",
        "fork_directories": [
          "img/frames/planeswalker/regular/",
          "img/frames/planeswalker/tall/",
          "img/frames/planeswalker/compleated/"
        ]
      },
      {
        "match": "Dungeon",
        "taxonomy_value": "dungeon",
        "fork_directories": [
          "img/frames/dungeon/regular/"
        ]
      },
      {
        "match": "Attraction",
        "taxonomy_value": "attraction",
        "fork_directories": [
          "img/frames/attraction/"
        ]
      },
      {
        "condition": "default",
        "taxonomy_value": "standard",
        "fork_directories": []
      }
    ]
  },
  "box_variant_mapping": {
    "source_fields": [
      "textless",
      "full_art",
      "type_line",
      "oracle_text",
      "layout"
    ],
    "rules": [
      {
        "condition": "textless == true and frame == '1997'",
        "taxonomy_value": "textless",
        "fork_directories": [
          "img/frames/seventh/textless/"
        ]
      },
      {
        "condition": "textless == true and frame == '2015'",
        "taxonomy_value": "textless",
        "fork_directories": [
          "img/frames/textless/2022/",
          "img/frames/textless/genericShowcase/",
          "img/frames/textless/invention/"
        ]
      },
      {
        "condition": "full_art == true and 'Basic Land' in type_line",
        "taxonomy_value": "textless",
        "fork_directories": [
          "img/frames/m15/basics/",
          "img/frames/textless/basics/",
          "img/frames/textless/zendikar/",
          "img/frames/textless/unhinged/"
        ]
      },
      {
        "condition": "set == 'sld' and 'Basic Land' in type_line and len(oracle_text) > 200",
        "taxonomy_value": "full_text",
        "fork_directories": [
          "img/frames/m15/fullText/"
        ]
      },
      {
        "condition": "'Planeswalker' in type_line and oracle_text.count('\\n') >= 3",
        "taxonomy_value": "tall",
        "fork_directories": [
          "img/frames/planeswalker/tall/"
        ]
      },
      {
        "condition": "layout == 'modal_dfc' and len(oracle_text) < 120",
        "taxonomy_value": "short",
        "fork_directories": [
          "img/frames/modal/short/"
        ]
      }
    ]
  },
  "has_nickname_mapping": {
    "source_field": "flavor_name",
    "rules": {
      "is_not_null": {
        "taxonomy_value": true,
        "fork_directories": [
          "img/frames/m15/nickname/",
          "img/frames/modal/nickname/",
          "img/frames/planeswalker/nickname/",
          "img/frames/promo/nickname/"
        ]
      },
      "is_null": {
        "taxonomy_value": false,
        "fork_directories": []
      }
    }
  },
  "crown_style_mapping": {
    "source_fields": [
      "frame_effects",
      "border_color",
      "type_line"
    ],
    "rules": [
      {
        "condition": "'legendary' not in frame_effects",
        "taxonomy_value": "none",
        "fork_directories": []
      },
      {
        "condition": "'legendary' in frame_effects and (border_color == 'borderless' or 'extendedart' in frame_effects)",
        "taxonomy_value": "floating",
        "fork_directories": [
          "img/frames/m15/crowns/"
        ],
        "filename_patterns": [
          "Floating\\.png$"
        ]
      },
      {
        "condition": "'legendary' in frame_effects and 'nyxtouched' in frame_effects",
        "taxonomy_value": "nyx",
        "fork_directories": [
          "img/frames/m15/innerCrowns/new/nyx/"
        ]
      },
      {
        "condition": "'legendary' in frame_effects and 'companion' in frame_effects",
        "taxonomy_value": "companion",
        "fork_directories": [
          "img/frames/m15/innerCrowns/new/companion/"
        ]
      },
      {
        "condition": "'legendary' in frame_effects and 'Sliver' in type_line",
        "taxonomy_value": "sliver",
        "fork_directories": [
          "img/frames/m15/m15MaskBorderSliverCrown.png"
        ]
      },
      {
        "condition": "'legendary' in frame_effects",
        "taxonomy_value": "standard",
        "fork_directories": [
          "img/frames/m15/crowns/"
        ]
      }
    ]
  },
