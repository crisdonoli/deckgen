  "texture_and_color_blend_mapping": {
    "source_fields": [
      "colors",
      "color_identity",
      "produced_mana",
      "type_line",
      "mana_cost",
      "frame",
      "frame_effects"
    ],
    "file_suffix_rules": [
      {
        "condition": "'Vehicle' in type_line",
        "texture_material": "vehicle_bronze_riveted",
        "color_blend_mode": "monocolor",
        "file_suffix": "v.png"
      },
      {
        "condition": "'Artifact' in type_line and len(colors) == 0",
        "texture_material": "artifact_brown_retro if frame in ['1993', '1997'] else artifact_steel_modern",
        "color_blend_mode": "monocolor",
        "file_suffix": "a.png"
      },
      {
        "condition": "'Land' in type_line and len(produced_mana) >= 3",
        "texture_material": "land_neutral",
        "color_blend_mode": "land_gold_pinline",
        "file_suffix": "ml.png"
      },
      {
        "condition": "'Land' in type_line and len(produced_mana) == 2",
        "texture_material": "land_neutral",
        "color_blend_mode": "land_dual_pinline",
        "file_suffix": "[c1][c2]l.png (masked with maskRightHalf.png)"
      },
      {
        "condition": "'Land' in type_line and len(produced_mana) == 1",
        "texture_material": "land_neutral",
        "color_blend_mode": "monocolor",
        "file_suffix": "[w|u|b|r|g]l.png"
      },
      {
        "condition": "'Land' in type_line and len(produced_mana) == 0",
        "texture_material": "land_neutral",
        "color_blend_mode": "monocolor",
        "file_suffix": "l.png"
      },
      {
        "condition": "'/' in mana_cost and len(colors) == 2",
        "texture_material": "hybrid_pair",
        "color_blend_mode": "hybrid_gradient",
        "file_suffix": "[c1].png + [c2].png (masked with maskRightHalf.png)"
      },
      {
        "condition": "len(colors) >= 2",
        "texture_material": "gold_metallic",
        "color_blend_mode": "gold_solid",
        "file_suffix": "m.png"
      },
      {
        "condition": "colors == ['W']",
        "texture_material": "white_marble",
        "color_blend_mode": "monocolor",
        "file_suffix": "w.png"
      },
      {
        "condition": "colors == ['U']",
        "texture_material": "blue_water",
        "color_blend_mode": "monocolor",
        "file_suffix": "u.png"
      },
      {
        "condition": "colors == ['B']",
        "texture_material": "black_swamp",
        "color_blend_mode": "monocolor",
        "file_suffix": "b.png"
      },
      {
        "condition": "colors == ['R']",
        "texture_material": "red_volcanic",
        "color_blend_mode": "monocolor",
        "file_suffix": "r.png"
      },
      {
        "condition": "colors == ['G']",
        "texture_material": "green_bark",
        "color_blend_mode": "monocolor",
        "file_suffix": "g.png"
      },
      {
        "condition": "len(colors) == 0",
        "texture_material": "colorless_stone",
        "color_blend_mode": "monocolor",
        "file_suffix": "c.png"
      }
    ]
  },
  "corner_cut_mapping": {
    "source_fields": [
      "set",
      "border_color"
    ],
    "rules": {
      "modern_radius": {
        "condition": "default",
        "taxonomy_value": "modern_radius",
        "fork_files": [
          "img/frames/cornerCutout.png",
          "img/frames/margins/blackCorners.png"
        ]
      },
      "square_corners": {
        "condition": "set in ['ced', 'cei']",
        "taxonomy_value": "square_corners",
        "fork_files": [],
        "procedural_fallback": "no_corner_clip"
      },
      "alpha_radius": {
        "condition": "set == 'lea'",
        "taxonomy_value": "alpha_radius",
        "fork_files": [],
        "procedural_fallback": "rounded_rect_radius_mm:4.0"
      },
      "asymmetric_corners": {
        "condition": "layout == 'vanguard'",
        "taxonomy_value": "asymmetric_corners",
        "fork_files": [],
        "procedural_fallback": "asymmetric_top_rounded_bottom_square"
      }
    }
  },
